# Libraries (must load first) -- vendored in libs/
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceTimer-3.0\AceTimer-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml

# Locales
# LOAD-BEARING: creates NS.L, which core\LauncherSetup.lua, defaults\*.lua and every settings\ file read at FILE SCOPE.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: NS.PREFIX, NS.name, NS.BRAND and the version fallback every file below reads.
core\Namespace.lua
# LOAD-BEARING: NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at FILE SCOPE.
core\MediaSetup.lua
core\Constants.lua
core\State.lua
# LOAD-BEARING: NS.Version(), called by core\PerfSetup.lua at FILE SCOPE.
core\EnvSetup.lua
# LOAD-BEARING: NS.Util.print (reclaimed by core\OutfitterReborn.lua at FILE SCOPE) and NS.LIBKA0S_MISSING (read by every stub below).
core\CoreSetup.lua
# LOAD-BEARING: RegisterOwner at FILE SCOPE, before EllesmereUI dispatches; NS.SKIN_OPTIONS is read by settings\General.lua at FILE SCOPE.
core\SkinSetup.lua
# LOAD-BEARING: NS.Compat, whose secret detectors core\Secrets.lua binds at FILE SCOPE. Compat itself reaches NS.Secrets
# at CALL time only (no file-scope capture), so it may precede Secrets; test_loadorder pins that.
core\Compat.lua
# LOAD-BEARING: NS.Secrets, captured at FILE SCOPE by modules\ItemInfo.lua, modules\States.lua and modules\Inventory.lua.
core\Secrets.lua
core\Bus.lua
core\PoolSetup.lua
core\ItemSetup.lua
core\WidgetsSetup.lua
core\SecureQueue.lua
# LOAD-BEARING: NS.lifecycle, which LibKa0s-Perf :New raises without.
core\LifecycleSetup.lua
# LOAD-BEARING: NS.Perf, captured at FILE SCOPE by the modules.
core\PerfSetup.lua
# LOAD-BEARING: needs FONT_MONO, NS.State and the printer, and precedes any NS.Debug call.
core\DebugLogSetup.lua
# LOAD-BEARING: NewAddon(NS, addonName, ...) and the NS.Print reclaim at FILE SCOPE, so it follows core\CoreSetup.lua.
core\OutfitterReborn.lua
core\Database.lua

# Defaults (the only place a default is hardcoded -- savedvariables-§2; pure data)
defaults\Profile.lua
